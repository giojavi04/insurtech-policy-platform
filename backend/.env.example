# Copia este archivo como `.env` dentro de `backend/` antes de ejecutar la API.

# La plantilla se mantiene aquí. Revisa la sección "Environment variables" del README.

# Cadena de conexión a PostgreSQL utilizada por Prisma.
# Para desarrollo local se usa la misma configuración Docker indicada en el README:
# docker run -d --name insurtech-pg -e POSTGRES_USER=insurtech \
# -e POSTGRES_PASSWORD=insurtech -e POSTGRES_DB=insurtech_dev -p 5432:5432 postgres:16
DATABASE_URL="postgresql://insurtech:insurtech@localhost:5432/insurtech_dev?schema=public"

# Clave utilizada para firmar y verificar los JWT generados en POST /auth/login.
# En local puede ser cualquier valor. Para otros ambientes usa una clave segura.
JWT_SECRET="local-dev-only-change-me"

# Tiempo de expiración del JWT. Formatos soportados por @nestjs/jwt: "1h", "3600s", etc.
JWT_EXPIRES_IN="1h"

# Puerto HTTP donde se ejecuta la aplicación Nest.
PORT=3000

# Usuario de prueba generado en prisma/seed.ts.
# Estas credenciales permiten obtener el Bearer token desde POST /auth/login
# y utilizar los endpoints POST /policies y GET /policies/{id}.
DEMO_USER_EMAIL="[demo@libelulasoft.com](mailto:demo@libelulasoft.com)"
DEMO_USER_PASSWORD="Demo1234!"
